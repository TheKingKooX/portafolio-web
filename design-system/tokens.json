{
  "primitive": {
    "color": {
      "ink":   { "950": { "$value": "#030a0c", "$type": "color" }, "900": { "$value": "#061216", "$type": "color" }, "700": { "$value": "#14262b", "$type": "color" }, "500": { "$value": "#8398a0", "$type": "color" } },
      "snow":  { "50": { "$value": "#eff6f7", "$type": "color" } },
      "cyan":  { "400": { "$value": "#22f7ff", "$type": "color" } },
      "green": { "400": { "$value": "#00f259", "$type": "color" } },
      "orange":{ "500": { "$value": "#ff8000", "$type": "color" } },
      "pink":  { "500": { "$value": "#ff3899", "$type": "color" } }
    },
    "space":  { "1": { "$value": "0.25rem", "$type": "dimension" }, "2": { "$value": "0.5rem", "$type": "dimension" }, "3": { "$value": "0.75rem", "$type": "dimension" }, "4": { "$value": "1rem", "$type": "dimension" }, "6": { "$value": "1.5rem", "$type": "dimension" }, "8": { "$value": "2rem", "$type": "dimension" }, "12": { "$value": "3rem", "$type": "dimension" }, "16": { "$value": "4rem", "$type": "dimension" } },
    "border": { "thin": { "$value": "1px", "$type": "dimension" }, "base": { "$value": "2px", "$type": "dimension" } },
    "shadow": { "rest": { "$value": "5px", "$type": "dimension" }, "lift": { "$value": "8px", "$type": "dimension" }, "press": { "$value": "2px", "$type": "dimension" } },
    "duration": { "fast": { "$value": "150ms", "$type": "duration" }, "base": { "$value": "200ms", "$type": "duration" }, "slow": { "$value": "500ms", "$type": "duration" } }
  },
  "semantic": {
    "color": {
      "bg":         { "$value": "{primitive.color.ink.950}", "$type": "color" },
      "surface":    { "$value": "{primitive.color.ink.900}", "$type": "color" },
      "line":       { "$value": "{primitive.color.ink.700}", "$type": "color" },
      "text":       { "$value": "{primitive.color.snow.50}", "$type": "color" },
      "text-muted": { "$value": "{primitive.color.ink.500}", "$type": "color" },
      "primary":    { "$value": "{primitive.color.cyan.400}", "$type": "color" },
      "success":    { "$value": "{primitive.color.green.400}", "$type": "color" },
      "warm":       { "$value": "{primitive.color.orange.500}", "$type": "color" },
      "accent":     { "$value": "{primitive.color.pink.500}", "$type": "color" },
      "on-primary": { "$value": "{primitive.color.ink.950}", "$type": "color" }
    }
  },
  "component": {
    "button": {
      "bg":        { "$value": "{semantic.color.primary}", "$type": "color" },
      "fg":        { "$value": "{semantic.color.on-primary}", "$type": "color" },
      "shadow":    { "$value": "{semantic.color.accent}", "$type": "color" },
      "hover-bg":  { "$value": "{semantic.color.success}", "$type": "color" }
    },
    "card": {
      "border": { "$value": "{semantic.color.line}", "$type": "color" },
      "bg":     { "$value": "{semantic.color.surface}", "$type": "color" }
    }
  }
}
